# =============================================================================
# ARCHAOS — Frontend Environment Variables (apps/web/.env)
# Copy this file to .env and fill in your values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser.
# NEVER commit .env to version control.
# =============================================================================

# --- Supabase Auth -----------------------------------------------------------
# Get these from your Supabase project dashboard → Settings → API.
# The anon key is safe to expose publicly — it has row-level security applied.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# --- Backend API URL ---------------------------------------------------------
# Points the frontend to the NestJS API.
# In development this defaults to http://localhost:5000 if not set.
VITE_API_URL="http://localhost:5000"
