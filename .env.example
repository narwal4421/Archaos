# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# PostgreSQL – Railway provides this automatically when you add the Postgres plugin
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# Redis – Railway provides this automatically when you add the Redis plugin
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# JWT – generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-to-a-strong-random-secret"
SUPABASE_URL="  DONT MAKE IT PUBLICK "
SUPABASE_ANON_KEY="RANDOM KEY "

# OpenAI – get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Port (Railway sets this automatically, leave as 5000)
PORT=5000
