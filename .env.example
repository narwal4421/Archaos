# =============================================================================
# ARCHAOS — Root Environment Variables (.env)
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string (used by Prisma).
# Railway / Render inject this automatically when you add a Postgres plugin.
# Local default (Docker Compose): postgresql://archaos_user:archaos_password@localhost:5433/archaos_db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public"

# --- Cache -------------------------------------------------------------------
# Redis connection URL (used for session caching & socket.io adapter).
# Railway / Render inject this automatically when you add a Redis plugin.
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# --- Auth --------------------------------------------------------------------
# Long, random secret for signing JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or:            openssl rand -hex 64
JWT_SECRET="change-me-to-a-secure-random-secret"

# --- Supabase (optional — used for cloud auth if not using local Postgres) ---
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="eyJ..."

# --- AI Narration (pick ONE of the two blocks below) -------------------------

# Option A: OpenRouter (recommended — provides access to multiple models
#           and automatic fallback across providers)
#           Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."

# Option B: OpenAI directly (uncomment & remove OPENROUTER_API_KEY above)
# OPENAI_API_KEY="sk-..."

# --- HTTP-Referer sent to OpenRouter -----------------------------------------
# Appears in your OpenRouter usage dashboard to identify traffic source.
SITE_REFERER="https://archaos.vercel.app"

# --- CORS --------------------------------------------------------------------
# If deploying the frontend to a custom domain, set it here so the API
# accepts WebSocket connections from that origin.
# FRONTEND_URL="https://your-custom-domain.com"

# --- Server ------------------------------------------------------------------
# Railway sets PORT automatically; leave as 5000 for local development.
PORT=5000
NODE_ENV=development
